{
  "name": "cbdc-research-pilot-regulatory",
  "version": "1.0.0",
  "description": "CBDC Research Pilot - Regulatory Validation Package - A comprehensive Central Bank Digital Currency research pilot system with full regulatory compliance capabilities, designed to meet international central bank standards",
  "main": "dist/demo-runner.js",
  "type": "module",
  "scripts": {
    "demo": "tsx src/demo-runner.ts basic",
    "demo:basic": "tsx src/demo-runner.ts basic",
    "demo:large": "tsx src/demo-runner.ts large",
    "demo:stress": "tsx src/demo-runner.ts stress",
    "demo:economic-shock": "tsx src/demo-runner.ts economic-shock",
    "demo:regulatory": "tsx src/demo-regulatory.ts",
    "dashboard:start": "tsx src/dashboard-server.ts",
    "generate:reports": "tsx src/demo-regulatory.ts && echo 'Reports generated in ./reports/'",
    "validate:all": "npm test -- --testPathPattern=regulatory-validation",
    "validate:compliance": "npm test -- --testNamePattern=\"Compliance Engine Validation\"",
    "validate:performance": "npm test -- --testNamePattern=\"Performance Validation\"",
    "validate:security": "npm test -- --testNamePattern=\"Security Validation\"",
    "validate:privacy": "npm test -- --testNamePattern=\"Privacy Analytics Validation\"",
    "profile:demo": "tsx --inspect --trace-gc --heap-prof src/demo-runner.ts basic",
    "profile:demo:basic": "tsx --inspect --trace-gc --heap-prof src/demo-runner.ts basic",
    "profile:demo:large": "tsx --inspect --trace-gc --heap-prof src/demo-runner.ts large",
    "profile:demo:stress": "tsx --inspect --trace-gc --heap-prof src/demo-runner.ts stress",
    "profile:demo:economic-shock": "tsx  --inspect --trace-gc --heap-prof src/demo-runner.ts economic-shock",
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "jest"
  },
  "keywords": [
    "cbdc",
    "central-bank-digital-currency",
    "regulatory-compliance",
    "aml",
    "kyc",
    "audit-trail",
    "privacy-analytics",
    "data-validation",
    "regulatory-validation",
    "central-bank",
    "financial-regulation",
    "compliance-engine",
    "risk-assessment",
    "sanctions-screening",
    "differential-privacy",
    "cryptographic-verification",
    "regulatory-reporting",
    "economic-simulation",
    "regulatory-dashboard",
    "blockchain",
    "digital-currency",
    "research",
    "simulation",
    "utl",
    "universal-topological-ledger",
    "600-cell",
    "identity",
    "asabiyyah"
  ],
  "author": "Brian Thorne, Axiomatic Development Team",
  "license": "MIT",
  "dependencies": {
    "jspdf": "^2.5.1",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.d.ts",
      "!**/node_modules/**",
      "!**/dist/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testTimeout": 30000
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bthornemail/research-pilot.git",
    "directory": "demos/cbdc-research-pilot"
  },
  "bugs": {
    "url": "https://github.com/bthornemail/research-pilot/issues"
  },
  "homepage": "https://github.com/bthornemail/research-pilot"
}
